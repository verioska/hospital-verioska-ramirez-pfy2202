{
  "name": "hospital-verioska-ramirez-pfy2202",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tienda de libros con React, React Router y una API REST mock. Desarrollo Frontend II, semana 4.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:api\" \"npm:client\"",
    "client": "vite --host 127.0.0.1",
    "api": "json-server --watch server/db.json --host 127.0.0.1 --port 3001",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "json-server": "0.17.4",
    "vite": "^7.2.2"
  }
}
